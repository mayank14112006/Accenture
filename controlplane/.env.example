# --- ControlPlane configuration (all optional; defaults run fully offline) ---

# Upstream LLM provider: "sim" (built-in scenario engine, offline, default) or "openai"
CP_PROVIDER=sim

# Only used when CP_PROVIDER=openai (any OpenAI-compatible endpoint)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Detector profile: "lite" (deterministic + lexical, zero heavy deps, default)
# or "full" (requires: pip install -r requirements-models.txt)
CP_DETECTOR_PROFILE=lite

# Keyed hashing for the evidence ledger (PII never stored as plain or bare-hash).
# Any random string. If unset, a per-run ephemeral key is used (fine for demo).
CP_LEDGER_HMAC_KEY=

# Policy pack signing key (HMAC). If set, packs must carry a valid .sig file.
# The committed .sig files were produced with this demo key; the production
# signing key lives OUTSIDE the client tenancy (see scripts/sign_policies.py).
CP_POLICY_SIGNING_KEY=demo-signing-key-rotate-in-prod

# Where SQLite stores live (created automatically)
CP_DATA_DIR=./data
